# GapFinder AI Environment Configuration

# Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Keep strictly server-side, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Used for text-embedding-004, gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-api-key

# Optional App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
